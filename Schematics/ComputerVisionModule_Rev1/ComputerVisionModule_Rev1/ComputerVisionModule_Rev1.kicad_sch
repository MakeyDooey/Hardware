	)
	(text "If UART between the MTL and the OPENMV4 goes wack after the H7 \nresets, consider also resetting the MV4 as it may have gotten\nmixed up by spamming UART messages"
		(exclude_from_sim no)
		(at 175.768 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
